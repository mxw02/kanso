# ==============================================
# KANSO - Environment Configuration
# ==============================================

# Server / API
PORT=4000
API_PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000

# Database (PostgreSQL)
DATABASE_URL=postgresql://kanso:kanso_secret@postgres:5432/kanso?schema=public
# For running locally outside docker:
# DATABASE_URL=postgresql://kanso:kanso_secret@localhost:5432/kanso?schema=public
POSTGRES_USER=kanso
POSTGRES_PASSWORD=kanso_secret
POSTGRES_DB=kanso
POSTGRES_PORT=5432

# Redis (Events & Queues)
REDIS_URL=redis://redis:6379
# For running locally outside docker:
# REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# MCP Server
MCP_PORT=3001
MCP_TRANSPORT=sse
KANSO_API_URL=http://api:4000

# Web UI
VITE_API_URL=http://localhost:4000
VITE_MCP_URL=http://localhost:3001
WEB_PORT=3000
