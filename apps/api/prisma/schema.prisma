generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MEMBER
  VIEWER
}

enum IssuePriority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum IssueType {
  TASK
  BUG
  STORY
  EPIC
}

enum AssigneeType {
  HUMAN
  AGENT
  UNASSIGNED
}

enum AgentRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  avatarUrl String?
  role      UserRole @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Workspace {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  projects    Project[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("workspaces")
}

model Project {
  id          String     @id @default(uuid())
  key         String     @unique // e.g. "KAN"
  name        String
  description String?
  
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  
  columns     Json?      // Customizable status columns: [{ id: "BACKLOG", title: "Backlog", color: "..." }]
  
  issues      Issue[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("projects")
}

model Issue {
  id            String        @id @default(uuid())
  identifier    String        @unique // e.g. "KAN-1"
  number        Int
  title         String
  description   String?       @db.Text
  status        String        @default("TODO")
  priority      IssuePriority @default(MEDIUM)
  type          IssueType     @default(TASK)
  assigneeType  AssigneeType  @default(UNASSIGNED)
  assigneeId    String?
  assigneeName  String?
  labels        String[]      @default([])
  agentMetadata Json?
  
  projectId     String
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  parentId      String?
  parent        Issue?        @relation("SubIssues", fields: [parentId], references: [id])
  subIssues     Issue[]       @relation("SubIssues")

  comments      Comment[]
  activities    ActivityLog[]
  agentRuns     AgentRun[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([projectId, status])
  @@index([identifier])
  @@map("issues")
}

model ActivityLog {
  id        String   @id @default(uuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actorType String   @default("HUMAN") // HUMAN, AGENT, SYSTEM
  actorName String
  action    String   // CREATED, STATUS_CHANGED, PRIORITY_CHANGED, ASSIGNED, UPDATED, COMMENTED
  details   String   @db.Text
  createdAt DateTime @default(now())

  @@index([issueId])
  @@map("activity_logs")
}

model Comment {
  id         String       @id @default(uuid())
  issueId    String
  issue      Issue        @relation(fields: [issueId], references: [id], onDelete: Cascade)
  authorType AssigneeType @default(HUMAN)
  authorName String
  content    String       @db.Text
  createdAt  DateTime     @default(now())

  @@index([issueId])
  @@map("comments")
}

model AgentRun {
  id            String         @id @default(uuid())
  issueId       String
  issue         Issue          @relation(fields: [issueId], references: [id], onDelete: Cascade)
  agentName     String         // e.g. "code-generator", "pr-reviewer", "triage-bot"
  agentModel    String?        // e.g. "claude-3-5-sonnet", "gemini-1.5-pro"
  status        AgentRunStatus @default(PENDING)
  prompt        String?        @db.Text
  resultSummary String?        @db.Text
  tokensUsed    Int?
  startedAt     DateTime       @default(now())
  endedAt       DateTime?

  @@index([issueId])
  @@map("agent_runs")
}
