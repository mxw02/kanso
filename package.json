{
  "name": "kanso-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Kanso - The Lean, Agent-First, MCP-Native Open Source Jira Alternative",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev": "npm run dev --workspaces",
    "lint": "npm run lint --workspaces",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:build": "docker compose build"
  },
  "keywords": [
    "kanso",
    "jira-alternative",
    "mcp",
    "model-context-protocol",
    "agentic",
    "ai-agents",
    "project-management",
    "issue-tracker"
  ],
  "author": "mxw02",
  "license": "Apache-2.0"
}
